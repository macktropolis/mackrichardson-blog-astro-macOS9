---
import { getCollection, type CollectionEntry } from "astro:content";

//  layout imports
import Layout from "../../layouts/Layout.astro";

//  component imports
import PostListWindow from "../../components/PostListWindow.astro";

//  utils imports
import { formatBlogPosts } from "../../js/utils";

// A single window listing every post -- pagination isn't worth the added
// complexity of a second window id per page while post count stays well
// under Astro's paginate() default pageSize (10); the window scrolls
// instead. Revisit if the blog grows past that.
export async function getStaticPaths() {
  return [{ params: { page: undefined } }];
}

const allPosts = await getCollection("blog");
const posts: CollectionEntry<"blog">[] = formatBlogPosts(allPosts);
const title = "All Blog Articles";
const description = "I write about comics, coding and everything in between.";
---

<Layout title={title} page="Files" description={description}>
  <main>
    <PostListWindow
      windowId="window-blog"
      windowTitle="Blog"
      posts={posts}
    />
  </main>
</Layout>
