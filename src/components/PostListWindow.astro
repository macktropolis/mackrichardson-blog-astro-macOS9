---
// Shared content for the Blog / Category / Tag list windows. The outer
// window chrome (title bar, close box) is generated by WindowManager.astro
// -- either by promoting this element in place (viewing the page directly)
// or by fetching it from elsewhere and extracting it -- so this only
// renders the id/title data contract plus the actual list.
import PostListRow from "./PostListRow.astro";

interface Props {
  windowId: string;
  windowTitle: string;
  posts: any[];
  emptyMessage?: string;
}

const {
  windowId,
  windowTitle,
  posts,
  emptyMessage = "No posts here yet.",
} = Astro.props;
---

<div
  id="window-content"
  data-window-id={windowId}
  data-window-title={windowTitle}
>
  <div class="post-list">
    {
      posts.length === 0 ? (
        <p class="post-list__empty">{emptyMessage}</p>
      ) : (
        posts.map((post) => <PostListRow data={post.data} url={post.id} />)
      )
    }
  </div>
</div>

<style>
  .post-list {
    width: min(640px, calc(100vw - 2rem));
  }
  .post-list__empty {
    color: hsl(var(--color-mid-2), 1);
    padding: 2rem;
    text-align: center;
  }
</style>
