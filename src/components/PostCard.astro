---
// library imports
import { Image } from "astro:assets";

// component imports
import TagCloud from "./Tags.astro";

// utils imports
import { slugify, formatDate } from "../js/utils";

const { data, url } = Astro.props;
const { title, date, author, image, description, category, tags } = data;
---

<div class="card__wrapper">
  <div class="card post">
    <header class="card__header">
      <img
        src="/assets/images/title-bar-close.png"
        height="28"
        width="28"
        class="control close"
        alt="Close"
      />
      <div class="title">
        <h3 class="card__title">
          <a href={`/category/${slugify(category)}/`} class="badge"
            >{category}</a
          >
        </h3>
        <span class={`icon ${slugify(category)}`}>&nbsp;</span>
      </div>
      <img
        src="/assets/images/title-bar-expand.png"
        height="28"
        width="28"
        class="control expand"
      />
      <img
        src="/assets/images/title-bar-collapse.png"
        height="28"
        width="28"
        class="control collapse"
      />
      <a href="#" class="button post-close" aria-label="Close">&nbsp;</a>
      <a
        href={`/blog/${slugify(url)}`}
        class="button expand"
        aria-label={`Read ${title}`}>&nbsp;</a
      >
    </header>

    <section class="card__content">
      <article>
        <header>
          <section class="hero-image">
            <a href={`/blog/${slugify(url)}`} aria-hidden="true" tabindex="-1">
              <svg xmlns="http://www.w3.org/2000/svg">
                <filter id="noiseFilter">
                  <feTurbulence
                    type="fractalNoise"
                    baseFrequency="0.5"
                    numOctaves="3"
                    stitchTiles="stitch"></feTurbulence>
                </filter>

                <rect width="100%" height="100%" filter="url(#noiseFilter)"
                ></rect>
              </svg>
              <Image
                src={image.src}
                alt={image.alt}
                class={image.class}
                widths={[560, 1120]}
                sizes="(min-width: 768px) 560px, 100vw"
                format="webp"
                quality={80}
              />
            </a>
          </section>
          <h2>
            <a href={`/blog/${slugify(url)}`}>{title}</a>
          </h2>
        </header>
        <!-- end: header -->

        <section class="post__content">
          <p>{description}</p>
          <a href={`/blog/${slugify(url)}`} class="button">Read More</a>
          <TagCloud tags={tags} />
        </section>
        <!-- end: post__content -->
      </article>
      <section class="card__meta">
        <p>
          <!-- <span
            class="disqus-comment-count"
            data-disqus-url={`https://www.mackrichardson.com/blog/${slugify(url)}`}
            >Comments</span
          > &bull; -->
          <a href={`/author/${slugify(author)}/`}>{author}</a>
          &bull; Posted: {formatDate(date)}
        </p>
      </section>
    </section>
  </div>
</div><!-- end: .card-wrapper -->

<style>
  .post .control.expand {
    opacity: 1 !important;
  }
  .card__wrapper {
    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
  }
  .card__wrapper.closing {
    opacity: 0;
    pointer-events: none;
    transform: scale(0.85);
  }
  @media (prefers-reduced-motion: reduce) {
    .card__wrapper {
      transition: none;
    }
  }
  p {
    font-size: clamp(1rem, 1.1rem, 1.2rem);
    line-height: 150%;
  }
  .tag-cloud {
    margin-bottom: 0.5rem;
  }
  .hero-image {
    margin: 0;
  }
  .card__content > article > header {
    border-bottom: 2px solid hsl(var(--color-dark), 1);
    display: grid;
    grid-template-areas: "title";
    margin: 0 auto;
    margin-top: 0.25px;
    width: 99.8%;
    position: relative;
    place-items: center;
  }
  .card__content > article > header > .hero-image,
  .card__content > article > header > h2 {
    grid-area: title;
    position: relative;
    z-index: 1;
  }
  .card__content > article > header > h2 {
    background-color: hsl(var(--color-dark), 0.5);
    border: none !important;
    box-shadow: none !important;
    color: hsl(var(--color-light), 1) !important;
    display: grid;
    place-items: center;
    font-size: clamp(2.25ch, 2.5rem, 2.75rem);
    height: 100%;
    line-height: 120%;
    margin: 0 !important;
    padding: 1rem 2rem;
    pointer-events: none;
    text-align: center;
    width: 100%;
    z-index: 2;
  }
  .card__content > article > header > :where(h2) a {
    color: hsl(var(--color-light), 1) !important;
  }
</style>

<script>
  // Click the close box on a post card to dismiss it, like closing a window.
  // Client-side only -- the post comes back on reload. Event-delegated on
  // document since Astro renders one PostCard per post on listing pages.
  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const closeLink = target.closest(".post-close");
    if (!closeLink) return;

    event.preventDefault();
    const wrapper = closeLink.closest(".card__wrapper");
    if (!wrapper) return;

    wrapper.classList.add("closing");
    setTimeout(() => wrapper.remove(), 250);
  });
</script>
