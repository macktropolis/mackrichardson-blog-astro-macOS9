---
// Lightweight desktop-style window manager for the popups (About, Holiday
// Cards, Mackintosh HD, Privacy) and any other element opted in via
// .wm-drag (currently just the Hero "MackOS 9.0" card).
//
// Popups keep their existing markup and href="#popup1".."#popup4" trigger
// links everywhere on the site -- this just intercepts clicks on those
// links (and a hashchange fallback for the Media.astro sidebar icons,
// which navigate via window.location.href on their own select/activate
// gesture) instead of relying on :target, so several can be open at once,
// each independently draggable and z-stacked. Each popup's own close
// anchor (the invisible <a class="button"> overlaying the close box) is
// rewired the same way, closing just that window instead of clearing the
// URL hash.
---

<style is:global>
  .popup .card__header,
  .wm-drag .card__header {
    cursor: grab;
  }
  /* Pages like /blog/slug carry their own internal .card__header (with its
     own close/expand controls and now the post title) from before they
     could be opened as a window. Once nested inside the generated outer
     chrome that duplicates it -- hide it rather than restructure markup
     that a lot of existing CSS depends on. The outer header is a *sibling*
     of .content-window__body, never inside it, so this can't match it. */
  .content-window__body .card__header {
    display: none;
  }
  /* Every window gets an inset content frame -- previously only post
     windows looked framed at all, and only by accident (their hero image
     happens to have a hard edge; nothing else did). Putting the border
     directly on .content-window__body, the same element that scrolls,
     means the scrollbar renders flush against this border's inner edge
     instead of out at the window's own outer edge. The margin is what
     makes it read as a distinct inner frame rather than merging into the
     outer shell's own border -- without it the two 2px borders just touch
     and look like one slightly-thicker line. The margin (16px, both sides)
     sits *outside* max-height's box, and the outer shell's own 2px border
     (4px, both sides) is outside it too -- both need subtracting on top of
     the general .card__content max-height in index.css (76px viewport
     margin + 40px header), or a tall window ends up up to 20px closer to
     the bottom of the viewport than WindowManager's own drag/centering
     clamp allows. outline (rather than a second border) adds the white
     highlight ring around the dark border without affecting box layout at
     all -- no further max-height math needed for it, unlike the margin. */
  .content-window__body {
    background-color: hsl(var(--color-light), 1);
    border: 2px solid hsl(var(--color-dark), 1);
    outline: 1px solid hsl(var(--color-light), 1);
    outline-offset: 0;
    margin: 18px;
    max-height: calc(100vh - 76px - 40px - 36px - 4px);
  }
  /* The gutter revealed by that margin is the outer shell's own
     background showing through -- set it explicitly so every content
     window's gutter matches, rather than leaving it to whatever .card.alt
     (or the post-specific white override below) happened to set it to. */
  .popup.content-window > .card {
    background-color: hsl(var(--color-mid), 1);
  }
  /* Same story as the header above: the nested .card (e.g. .card.post from
     blog/[slug].astro and about.astro) still carries the base .card's own
     background/border/shadow from before it could be opened as a window,
     which now just duplicates the outer chrome this file generates --
     "a window within a window". Neutralize it here rather than restructure
     markup that's also the page's real, fully-crawlable, no-JS content.
     The white embossed .card__content article "paper" look underneath is
     untouched -- only the outer box's own chrome is stripped. */
  .content-window__body .card {
    background: none;
    border: none;
    box-shadow: none;
  }
  /* The nested .card carries its own .card__content too (same double-chrome
     situation as .card above) -- it's also a .card__content, so it picks up
     the scrolling max-height/overflow-y from that rule in index.css, giving
     two nested scrollbars (one on the outer content-window__body, one on
     this inner box) with the outer's padding gap visible between them.
     Only the outer one should scroll; let this one size to its content. */
  .content-window__body .card__content {
    max-height: none;
    overflow-y: visible;
    padding: 0;
  }
  /* And its padding: the nested page already brings its own internal
     padding at a deeper level (e.g. about.astro's #content, the post's
     #content), so the outer shell's own padding would just double it up as
     a gap between the window edge and that inner padding. Only windows
     that nest a .card need this -- the plain Blog/Category/Tag list
     windows have no nested .card and still want the outer shell's padding
     around their post rows. */
  .content-window__body:has(.card) {
    padding: 0;
  }
  /* The 10px added to the gutter above comes out of this padding to
     compensate -- the plain Blog/Category/Tag list windows are the only
     content windows with any padding left to reduce (index.css's
     .card__content: 1rem/16px), since :has(.card) already zeroes it above
     for the rest. */
  .content-window__body:not(:has(.card)) {
    padding: 6px 6px 0;
  }
  /* Post windows read better wider than the 700px popups use (About,
     Privacy, etc. via .popup > div.card { max-width: 700px }). */
  .popup[id^="window-post-"] > .card {
    max-width: 900px;
  }
  /* Long post titles would otherwise stretch the title bar or wrap; clip
     to roughly 30 characters with an ellipsis instead. */
  .popup[id^="window-post-"] .card__header h3 {
    max-width: 30ch;
    overflow: hidden;
  }
  /* Privacy and Holiday Cards get the same inset content frame as the
     content windows above -- gutter, dark border, white highlight outline.
     They're plain .popup markup (not built by buildWindowShell), so this
     targets them directly by id rather than through .content-window__body.
     An id selector reliably outranks each popup's own scoped .card__content
     rule (padding, in both cases) regardless of source order, so padding is
     the one thing intentionally left alone here -- unlike the list windows
     above, there's no prior smaller gutter to size a matching reduction
     against. */
  #popup2 > .card,
  #popup4 > .card {
    background-color: hsl(var(--color-mid), 1);
  }
  #popup2 .card__content,
  #popup4 .card__content {
    background-color: hsl(var(--color-light), 1);
    border: 2px solid hsl(var(--color-dark), 1);
    outline: 1px solid hsl(var(--color-light), 1);
    outline-offset: 0;
    margin: 18px;
    /* Same 156px (76 + 40 + 36 + 4) budget as .content-window__body above --
       menu bar + margin, header, this new gutter margin, this new border. */
    max-height: calc(100vh - 76px - 40px - 36px - 4px);
  }
</style>

<script>
  let topZ = 1000;

  // SiteHeader.astro's menu bar is a fixed 28px strip pinned to the top of
  // the viewport; windows are always stacked above it (z-index), so nothing
  // stops one from being positioned or dragged underneath it unless we
  // clamp `top` ourselves. WINDOW_MARGIN is the breathing room every window
  // keeps beyond that -- below the menu bar at the top, and above the
  // viewport's own bottom edge -- so a window is never flush against
  // either. The max-height calc()s in index.css (.popup), Hero.astro
  // (.wm-drag) and below (.content-window__body) reserve the same
  // MENU_BAR_HEIGHT + WINDOW_MARGIN*2 = 76px total budget; keep all four in
  // sync if either constant changes.
  const MENU_BAR_HEIGHT = 28;
  const WINDOW_MARGIN = 24;
  const MIN_WINDOW_TOP = MENU_BAR_HEIGHT + WINDOW_MARGIN;

  // The lowest a window's top edge can sit while keeping WINDOW_MARGIN of
  // clearance above the viewport's bottom edge, given its current height.
  // Never lower than MIN_WINDOW_TOP -- a window taller than the available
  // space clamps to the top instead of the bottom.
  function maxWindowTop(height: number): number {
    return Math.max(MIN_WINDOW_TOP, window.innerHeight - WINDOW_MARGIN - height);
  }

  function bringToFront(win: HTMLElement) {
    topZ += 1;
    win.style.zIndex = String(topZ);
  }

  // A position:fixed box with only `left` set (no `right`) and an
  // auto/fit-content width isn't just sized to its content -- the
  // shrink-to-fit algorithm treats the distance from `left` to the
  // viewport's right edge as the available width, so the box narrows as
  // `left` grows. Freezing an explicit pixel width the first time a window
  // is positioned (measured while it's still unconstrained) stops it from
  // resizing itself as it's centered or dragged.
  function freezeWidth(win: HTMLElement) {
    if (win.style.width) return;
    win.style.width = `${win.getBoundingClientRect().width}px`;
  }

  function centerWindow(win: HTMLElement, cascade: number) {
    freezeWidth(win);
    const rect = win.getBoundingClientRect();
    const offset = cascade * 24;
    const left = Math.max(16, (window.innerWidth - rect.width) / 2 + offset);
    const top = Math.min(
      maxWindowTop(rect.height),
      Math.max(MIN_WINDOW_TOP, (window.innerHeight - rect.height) / 2 + offset),
    );
    win.style.left = `${left}px`;
    win.style.top = `${top}px`;
  }

  function makeDraggable(win: HTMLElement) {
    const handle = win.querySelector<HTMLElement>(".card__header");
    if (!handle) return;

    handle.addEventListener("pointerdown", (event) => {
      if (!(event.target instanceof Element)) return;
      // Let the close/expand overlay anchors handle their own click
      // instead of starting a drag.
      if (event.target.closest("a.button")) return;
      if (event.button !== 0) return;

      // Once the pointer clamps at MIN_WINDOW_TOP, it can keep moving past
      // the window (e.g. up into the fixed menu bar) while still "down" --
      // without this, the browser reads that as a text-selection drag and
      // highlights whatever's under the cursor.
      event.preventDefault();
      const prevUserSelect = document.body.style.userSelect;
      document.body.style.userSelect = "none";

      bringToFront(win);

      freezeWidth(win);
      const startRect = win.getBoundingClientRect();
      win.style.position = "fixed";
      win.style.left = `${startRect.left}px`;
      win.style.top = `${startRect.top}px`;
      win.style.margin = "0";

      const startX = event.clientX;
      const startY = event.clientY;
      const origLeft = startRect.left;
      const origTop = startRect.top;

      const onMove = (moveEvent: PointerEvent) => {
        win.style.left = `${origLeft + moveEvent.clientX - startX}px`;
        // WINDOW_MARGIN's extra breathing room is only for how a window
        // opens/centers -- once the user is actively dragging it, it can
        // go anywhere below the menu bar, including off the bottom edge.
        const rawTop = origTop + moveEvent.clientY - startY;
        win.style.top = `${Math.max(MENU_BAR_HEIGHT, rawTop)}px`;
      };
      const onUp = () => {
        document.body.style.userSelect = prevUserSelect;
        window.removeEventListener("pointermove", onMove);
        window.removeEventListener("pointerup", onUp);
      };
      window.addEventListener("pointermove", onMove);
      window.addEventListener("pointerup", onUp, { once: true });
    });
  }

  // -- Popups: open/close by id, several can be open at once ---------------

  const popups = Array.from(document.querySelectorAll<HTMLElement>(".popup"));

  // Other components (the Control Strip) listen for this to keep their own
  // "is this window open" indicator in sync, however the window was
  // opened or closed.
  function announce(id: string, isOpen: boolean) {
    window.dispatchEvent(
      new CustomEvent("wm:popup-toggle", { detail: { id, isOpen } }),
    );
  }

  function openPopup(popup: HTMLElement) {
    if (!popup.classList.contains("is-open")) {
      popup.classList.add("is-open");
      if (!popup.dataset.positioned) {
        const openCount = popups.filter((p) =>
          p.classList.contains("is-open"),
        ).length;
        centerWindow(popup, openCount - 1);
        popup.dataset.positioned = "true";
      }
      announce(popup.id, true);
    }
    bringToFront(popup);
  }

  function closePopup(popup: HTMLElement) {
    if (!popup.classList.contains("is-open")) return;
    popup.classList.remove("is-open");
    announce(popup.id, false);
  }

  // Open if closed; close if already open, regardless of which window is
  // currently frontmost.
  function togglePopupById(id: string) {
    const popup = document.getElementById(id);
    if (!popup || !popup.classList.contains("popup")) return;
    if (popup.classList.contains("is-open")) {
      closePopup(popup);
    } else {
      openPopup(popup);
    }
  }

  popups.forEach((popup) => {
    makeDraggable(popup);

    const closeLink = popup.querySelector<HTMLAnchorElement>(
      ".card__header > a.button:not(.expand)",
    );
    closeLink?.addEventListener("click", (event) => {
      event.preventDefault();
      closePopup(popup);
    });

    popup.addEventListener("pointerdown", () => bringToFront(popup));
  });

  // Any link to #popup1..4 toggles that window instead of navigating --
  // except inside .media, which has its own select/double-click gesture
  // and falls through to the hashchange handler below once it activates.
  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    const link = event.target.closest<HTMLAnchorElement>('a[href^="#popup"]');
    if (!link || link.closest(".media")) return;

    event.preventDefault();
    togglePopupById(link.getAttribute("href")!.slice(1));
  });

  function handlePopupHash() {
    const id = location.hash.slice(1);
    if (/^popup\d$/.test(id)) {
      togglePopupById(id);
      history.replaceState(null, "", location.pathname + location.search);
    }
  }
  window.addEventListener("hashchange", handlePopupHash);
  handlePopupHash();

  // -- Anything else opted into dragging (e.g. the Hero card) ---------------

  document.querySelectorAll<HTMLElement>(".wm-drag").forEach((win) => {
    makeDraggable(win);
    win.addEventListener("pointerdown", () => bringToFront(win));
  });

  // -- #hero-window: "open if closed", not a toggle -------------------------
  //
  // Hero.astro's own close box adds the "closing" class (fading it out and
  // leaving it in the DOM rather than removing it); nothing else removes
  // that class again to bring it back except this. Unlike the popup
  // triggers above, clicking one of these links always ensures the window
  // is open and frontmost -- it never closes an already-open window.
  //
  // #hero-window only exists on the homepage, but the links that open it
  // (Control Strip, Apple menu) are sitewide, so they point at the
  // absolute /#hero-window. On the homepage itself that's handled in
  // place below (no navigation); from anywhere else the browser actually
  // navigates there, and handleHeroHash picks it up once that page loads.
  function openHeroWindow(hero: HTMLElement) {
    hero.classList.remove("closing");
    bringToFront(hero);
  }

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    const link = event.target.closest<HTMLAnchorElement>(
      'a[href="/#hero-window"]',
    );
    if (!link) return;

    const hero = document.getElementById("hero-window");
    if (!hero) return; // not on the homepage -- let it navigate there

    event.preventDefault();
    openHeroWindow(hero);
  });

  function handleHeroHash() {
    if (location.hash !== "#hero-window") return;
    const hero = document.getElementById("hero-window");
    if (hero) openHeroWindow(hero);
    history.replaceState(null, "", location.pathname + location.search);
  }
  window.addEventListener("hashchange", handleHeroHash);
  handleHeroHash();

  // -- Content windows: blog list, category list, tag list, single posts ---
  //
  // Unlike the popups above, there's no fixed set of these -- they're built
  // on demand. Every target page (blog list, category list, tag list, post)
  // renders its real content inside a #window-content element carrying
  // data-window-id and data-window-title, so each one works as a normal,
  // fully crawlable page with no JS. With JS, a page promotes its own
  // #window-content into a floating window in place on load (no network
  // round trip, no duplication); a click on a link to a *different* one of
  // these pages fetches that page and extracts the same element instead of
  // navigating. Either way the result is registered the same way, so a
  // "Read More" link inside one fetched window opens another on top of it
  // exactly like a link on the original page would.

  const contentWindows = new Map<string, HTMLElement>();

  function registerContentWindow(win: HTMLElement) {
    makeDraggable(win);
    const closeLink = win.querySelector<HTMLAnchorElement>(
      ".card__header > a.button:not(.expand)",
    );
    closeLink?.addEventListener("click", (event) => {
      event.preventDefault();
      win.classList.remove("is-open");
    });
    win.addEventListener("pointerdown", () => bringToFront(win));
    contentWindows.set(win.id, win);
  }

  function openWindowElement(win: HTMLElement) {
    if (!win.classList.contains("is-open")) {
      win.classList.add("is-open");
      if (!win.dataset.positioned) {
        const openCount = Array.from(contentWindows.values()).filter((w) =>
          w.classList.contains("is-open"),
        ).length;
        centerWindow(win, openCount - 1);
        win.dataset.positioned = "true";
      }
    }
    bringToFront(win);
  }

  // iconClass is one of the .icon.<slugified-category> classes in
  // index.css (e.g. "coding") -- omitted entirely for window types (Blog,
  // Category, Tag lists) that don't carry one, rather than falling back to
  // the generic finder.png .icon default.
  function buildWindowShell(
    id: string,
    titleText: string,
    iconClass?: string,
  ): HTMLElement {
    const win = document.createElement("div");
    win.className = "popup content-window";
    win.id = id;
    win.innerHTML = `
      <div class="card alt featured">
        <header class="card__header">
          <img src="/assets/images/title-bar-close.png" height="28" width="28" class="control close" alt="Close" />
          <div class="title">
            <h3 class="card__title"></h3>
          </div>
          <img src="/assets/images/title-bar-expand.png" height="28" width="28" class="control expand" />
          <img src="/assets/images/title-bar-collapse.png" height="28" width="28" class="control collapse" />
          <a href="#" class="button" aria-label="Close">&nbsp;</a>
        </header>
        <section class="card__content content-window__body"></section>
      </div>
    `;
    const titleEl = win.querySelector<HTMLElement>(".card__title");
    if (titleEl) titleEl.textContent = titleText;
    if (iconClass) {
      const icon = document.createElement("span");
      icon.className = `icon ${iconClass}`;
      icon.innerHTML = "&nbsp;";
      win.querySelector(".title")?.appendChild(icon);
    }
    document.body.appendChild(win);
    return win;
  }

  // Astro's per-component CSS (scoped via data-astro-cid-* attributes, or
  // is:global) is bundled per page at build time -- it doesn't travel with
  // a fetched HTML fragment on its own. The extracted markup keeps its
  // data-astro-cid attributes, so copying over the source page's <style>
  // tags (deduped by content, since e.g. every list page shares
  // PostListRow's styles) makes them apply correctly once appended here.
  const importedStyles = new Set<string>(
    Array.from(document.querySelectorAll("style")).map(
      (s) => s.textContent ?? "",
    ),
  );
  function importStylesFrom(doc: Document) {
    doc.querySelectorAll("style").forEach((style) => {
      const css = style.textContent ?? "";
      if (!css || importedStyles.has(css)) return;
      importedStyles.add(css);
      document.head.appendChild(style.cloneNode(true));
    });
  }

  function promoteOwnContent() {
    const source = document.getElementById("window-content");
    if (!source) return;

    const id = source.dataset.windowId;
    const title = source.dataset.windowTitle;
    const icon = source.dataset.windowIcon;
    if (!id || !title || contentWindows.has(id)) return;

    const win = buildWindowShell(id, title, icon);
    const body = win.querySelector<HTMLElement>(".content-window__body")!;
    while (source.firstChild) body.appendChild(source.firstChild);
    source.remove();

    registerContentWindow(win);
    openWindowElement(win);
  }

  async function openContentWindowFromURL(id: string, url: string) {
    const existing = contentWindows.get(id);
    if (existing) {
      openWindowElement(existing);
      return;
    }

    let html: string;
    try {
      const response = await fetch(url);
      if (!response.ok) {
        location.href = url;
        return;
      }
      html = await response.text();
    } catch {
      location.href = url;
      return;
    }

    const doc = new DOMParser().parseFromString(html, "text/html");
    const source = doc.getElementById("window-content");
    if (!source) {
      location.href = url;
      return;
    }
    const title = source.dataset.windowTitle || doc.title;
    const icon = source.dataset.windowIcon;
    importStylesFrom(doc);

    const win = buildWindowShell(id, title, icon);
    const body = win.querySelector<HTMLElement>(".content-window__body")!;
    body.innerHTML = source.innerHTML;

    registerContentWindow(win);
    openWindowElement(win);
  }

  function contentWindowIdForPath(path: string): string | null {
    if (path === "/about" || path === "/about/") return "window-about";
    if (path === "/blog" || path === "/blog/") return "window-blog";
    let match = path.match(/^\/category\/([^/]+)\/?$/);
    if (match) return `window-category-${match[1]}`;
    match = path.match(/^\/tags\/([^/]+)\/?$/);
    if (match) return `window-tag-${match[1]}`;
    match = path.match(/^\/blog\/([^/]+)\/?$/);
    if (match) return `window-post-${match[1]}`;
    return null;
  }

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)
      return;

    const link = event.target.closest<HTMLAnchorElement>("a[href]");
    if (!link || link.target === "_blank") return;

    const href = link.getAttribute("href");
    if (!href) return;
    const path = href.split("#")[0].split("?")[0];
    const id = contentWindowIdForPath(path);
    if (!id) return;

    event.preventDefault();
    openContentWindowFromURL(id, path);
  });

  promoteOwnContent();
</script>
