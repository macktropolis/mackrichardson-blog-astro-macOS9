---
// data imports
import * as site from "../data/site.json";

interface Props {
  title?: string;
  description?: string;
  author?: string;
}

const { title, description } = Astro.props;
const { version } = site;
const headerTitle = "MackOS";
---

<div class="card__wrapper wm-drag" id="hero-window">
  <div class="card alt featured" id="about">
    <header class="card__header">
      <img
        src="/assets/images/title-bar-close.png"
        height="28"
        width="28"
        class="control close"
        alt="Close"
      />
      <div class="title">
        <h3 class="card__title">{headerTitle} {version}</h3>
        <span class="icon">&nbsp;</span>
      </div>
      <img
        src="/assets/images/title-bar-expand.png"
        height="28"
        width="28"
        class="control expand"
      />
      <img
        src="/assets/images/title-bar-collapse.png"
        height="28"
        width="28"
        class="control collapse"
      />
      <a href="#" class="button hero-close" aria-label="Close">&nbsp;</a>
      <a href="#popup1" class="button expand" aria-label="About Mack">&nbsp;</a>
    </header>

    <section class="card__content">
      <article>
        <img
          src="/assets/images/mack.png"
          alt="Mack"
          class="avatar"
          id="mack"
        />
        <h1>{title ?? "Mack Richardson"}</h1>
        <p>
          Hi, I'm <b>{title ?? "Mack Richardson"}</b>&mdash;a FileMaker and web
          developer based in North Carolina. I create applications and websites,
          and use this site to share projects, experiments, and things I've
          learned along the way.
        </p>
        <a href="
            #popup1" class="button primary">About Mack</a>
      </article>
    </section>
  </div>
</div><!-- end: .card-wrapper -->

<style>
  .control.expand {
    opacity: 1 !important;
  }
  /* Center as a floating window on the empty desktop from first paint --
     the inset:0 + margin:auto trick centers a fixed-position box of a
     capped-but-otherwise-content-sized width/height without transform, so
     there's nothing for WindowManager's drag positioning (which sets
     explicit left/top/margin:0) to fight with once dragging takes over. */
  .card__wrapper.wm-drag {
    height: fit-content;
    inset: 0;
    margin: auto;
    max-height: calc(100vh - 2rem);
    position: fixed;
    width: min(700px, calc(100vw - 2rem));
  }
  .card__wrapper {
    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
  }
  .card__wrapper.closing {
    opacity: 0;
    pointer-events: none;
    transform: scale(0.85);
  }
  @media (prefers-reduced-motion: reduce) {
    .card__wrapper {
      transition: none;
    }
  }
  .card__content article {
    display: flow-root;
    padding: 1rem;
  }
  .card__content article h1 {
    display: none;
    font-size: clamp(2rem, 3rem, 4rem);
    line-height: 120%;
  }
  .card__content article p {
    font-size: clamp(1.2rem, 1.1rem, 1rem);
    line-height: 150%;
    margin-bottom: 0.5rem !important;
    text-align: left;
  }
  .card__content article p:last-of-type {
    margin-bottom: 1.5rem !important;
  }
  .card__content article .avatar {
    float: left;
    height: auto !important;
    width: 200px !important;
    shape-outside: url("/assets/images/mack.png");
    shape-margin: 1.5rem !important;
  }
  .card__content .button {
    margin-bottom: 1rem;
    margin-inline: auto;
  }
</style>

<script>
  // Click the close box to dismiss the MackOS 9.0 card, like closing a
  // window. It stays in the DOM (just faded out / non-interactive) rather
  // than being removed, so WindowManager.astro can reopen it later --
  // e.g. from the Control Strip or the Apple menu's "About Mack
  // Richardson..." link.
  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const closeLink = target.closest(".hero-close");
    if (!closeLink) return;

    event.preventDefault();
    const wrapper = closeLink.closest(".card__wrapper");
    if (!wrapper) return;

    wrapper.classList.add("closing");
  });
</script>
